# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: "node_modules/" matches only a directory, so a worktree's
# node_modules symlink slipped past it and was committed (48153c0).
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# build output
*.apk
*.aab

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local expo modules keep their sources tracked, but not their gradle output
modules/*/android/build/
modules/*/android/.gradle/
