# React Native's native modules resolve paths by walking up from their own
# location on disk, so they need a flat node_modules. pnpm's default layout is
# a content-addressed store with symlinks, and under it @shopify/react-native-skia
# hands CMake a NODE_MODULES_DIR inside .pnpm/ and an unexpanded
# `react-native-0*` glob — its C++ build then fails to find React Native at all.
#
# JS-only dependencies never noticed; only a native build does. Hoisting costs
# disk and pnpm's strictness about undeclared imports, which is a fair trade for
# native modules building.
node-linker=hoisted

# Install-script approvals (Skia, Sentry) live in pnpm-workspace.yaml: pnpm does
# not read onlyBuiltDependencies from here.
