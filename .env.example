# Copy to .env and point at your backend.
#
# "localhost" refers to the device/simulator itself, not your dev machine, so
# the default below only works when the backend and Metro run on the exact
# same machine as a web browser would. For an emulator/device you almost
# always need to override this:
#   Android emulator  -> http://10.0.2.2:8000/api
#   iOS simulator      -> http://localhost:8000/api (usually fine)
#   Physical device     -> http://<your-machine-LAN-IP>:8000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Sentry — crash reporting. Not a secret (send-only), but keep it in env
# so forks and local builds do not post into our project.
EXPO_PUBLIC_SENTRY_DSN=
